&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    status = "okay";
    clock-frequency = <400000>;

    imu: ism330@6b {
        compatible = "st,ism330dhcx";
        reg = <0x6b>;
    };
};

&can1 {
    pinctrl-0 = <&can1_rx_pa11 &can1_tx_pa12>;
    pinctrl-names = "default";
    status = "okay";
    bitrate = <1000000>;
};

&can2 {
    pinctrl-0 = <&can2_rx_pb12 &can2_tx_pb13>;
    pinctrl-names = "default";
    status = "okay";
    bitrate = <1000000>;
};

&usart1 { //Controller
    pinctrl-0 = <&usart1_rx_pa10>; // tx isn't connected because this is the controller
    pinctrl-names = "default";
    status = "okay";
    current-speed = <921600>;
};

&usart3 { //Ref
    pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
    pinctrl-names = "default";
    status = "okay";
};
