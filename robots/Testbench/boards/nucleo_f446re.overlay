&i2c1 { //The node is labeled with &i2c1, which just lets zephyr know to reference its internal i2c1 setting for our board
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>; // pinctrl-0 just sets the pins we want, in this case we're using & again since these are specific pins within the .dtsi
    pinctrl-names = "default"; // This just lets the compiler know we're using the default names and not some alias
    status = "okay"; // status is what enables/disables the node; okay means enabled, "disabled" means disabled
    clock-frequency = <100000>; // Note that each communication protocol can have a different keyword for clockspeed

    scl-gpios = <&gpiob 8 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; // These two lines set default behavior for the clock and datalines
    sda-gpios = <&gpiob 7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;


    imu: ism330@6a { //This is a childnode, note the @6a, which just lets zephyr know what the address is
        compatible = "st,ism330dhcx"; //listing compatible drivers
        reg = <0x6a>; // defining the register again
    };
};

//Here in the overlay, I assigned the particular pin of the controller to act as particular lines required for the transmission of information under particular protocols.
// ADD YOUR CAN NODES HERE

&can1{
    pinctrl-0=<&can1_tx_pa12 &can1_rx_pa11>;//structure: &can1_td(the trans out)_pinname(pb8)
    pinctrl-names="default";
    status="okay";
    bitrate=<1000000>;
};

&can2{
    pinctrl-0=<&can2_tx_pb13 &can2_rx_pb12>;
    pinctrl-names="default";
    status="okay";
    bitrate=<1000000>;
};


&usart1 { //Controller
    pinctrl-0 = <&usart1_rx_pa10>; // tx isn't connected because this is the controller
    pinctrl-names = "default";
    status = "okay";
    current-speed = <921600>;
};

&usart3 { //Ref
    pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
    pinctrl-names = "default";
    status = "okay";
};

&uart5 {
    pinctrl-0 = <&uart5_tx_pc12 &uart5_rx_pd2>;
    pinctrl-names = "default";
    status = "okay";
    current-speed = <115200>;
};

&timers3 { // Encoder | PWM is done thru timer node, PB_4 is timer3 channel 1
    status = "okay";
    st,prescaler = <83>;   // tune below

    pwm3: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pb4>;
        pinctrl-names = "default";
        #pwm-cells = <3>;
    };
};

/ {
    pwm_encoder_ch: zephyr,user { //Node has to be named "zephyr,user" so it compiles
        pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        status = "okay";
    };
};


/* The sigular slash below indicates that we're just making a new node
Unlike the ones above, which were already declared for us in the
root dts file Zephyr has for us, this LED node is specific to us */
/ {
    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
            label = "LED0";
        };
        led1: led_1 {
            gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
            label = "LED1";
        };
        led2: led_2 {
            gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
            label = "LED2";
        };

        LD2: LD_2 {
            gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
            label = "User LD2";
        };
    };

    aliases {
        //Left hand side lives in a diff namespace than right hand side
        //So this doesn't break everything I swear
        led0 = &led0;
        led1 = &led1;
        led2 = &led2;
    };
};

  &gpiob {
       status = "okay";
   };

   &gpioc {
       status = "okay";
   };
