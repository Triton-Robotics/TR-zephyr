&fdcan1 {
    status = "okay";
    pinctrl-0 = <&fdcan1_rx_pb8 &fdcan1_tx_pb7>;
    pinctrl-names = "default";
    bitrate = <1000000>;
};

&fdcan2 {
    status = "okay";
    pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb6>;
    pinctrl-names = "default";
    bitrate = <1000000>;
};

&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    status = "okay";
    clock-frequency = <100000>;

	scl-gpios = <&gpiob 8 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpiob 7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;


    imu: ism330@6a {
        compatible = "st,ism330dhcx";
        reg = <0x6a>;
    };
};

&usart1 { //Controller
    pinctrl-0 = <&usart1_rx_pa10>; // tx isn't connected because this is the controller
    pinctrl-names = "default";
    status = "okay";
    current-speed = <921600>;
};

&usart3 { //Ref
    pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
    pinctrl-names = "default";
    status = "okay";
};

&uart5 {
    status="okay"
}


&timers3 { // Encoder | PWM is done thru timer node, PB_4 is timer3 channel 1
    status = "okay";
    st,prescaler = <83>;   // tune below

    pwm3: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pb4>;
        pinctrl-names = "default";
        #pwm-cells = <3>;
    };
};

/ {
    pwm_encoder_ch: zephyr,user { //Node has to be named "zephyr,user" so it compiles
        pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        status = "okay";
    };
};


/* The sigular slash below indicates that we're just making a new node
Unlike the ones above, which were already declared for us in the
root dts file Zephyr has for us, this LED node is specific to us */
/ {
    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
            label = "LED0";
        };
        led1: led_1 {
            gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
            label = "LED1";
        };
        led2: led_2 {
            gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
            label = "LED2";
        };

        LD2: LD_2 {
            gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
            label = "User LD2";
        };
    };

    aliases {
        //Left hand side lives in a diff namespace than right hand side
        //So this doesn't break everything I swear
        led0 = &led0;
        led1 = &led1;
        led2 = &led2;
    };
};

  &gpiob {
       status = "okay";
   };

   &gpioc {
       status = "okay";
   };
