.PHONY: infantry-build infantry-flash

BOARD = nucleo_f446re

# Prefer the checkout's Python: moved virtualenv activation scripts and west
# launchers may still contain absolute paths to their original location.
ifneq ($(wildcard .venv/bin/python),)
WEST ?= "./.venv/bin/python" -m west
else
WEST ?= west
endif


# "Clean" builds will always fail at first because of a zephyr race condition. So we
# build twice to make sure it goes through. The leading - just means that we ignore the error
# from the first build and proceed with rebuilding.

hero-build:
	$(WEST) build -b $(BOARD) -p auto -d build/Hero robots/Hero

hero-build-clean:
	-$(WEST) build -b $(BOARD) -p always -d build/Hero robots/Hero
	$(MAKE) hero-build

hero-flash: hero-build
	powershell.exe -Command "jlink.exe -device STM32F446RE -if SWD -speed 4000 -CommanderScript Jlink/flashHero.jlink"

